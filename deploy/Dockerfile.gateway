FROM python:3.12-slim
# TDCA Gateway 镜像：由仓内正源 true-source/tdca-web 构建（3180 第②段·部署改源）
# FROZEN zip 已转归档（deploy/archive/），⛔ 不再作运行源（GSEQ-3180）
RUN pip install --no-cache-dir fastapi "uvicorn>=0.52" sqlalchemy alembic httpx websockets
COPY true-source/tdca-web /app/tdca-web
WORKDIR /app/tdca-web/gateway
ENV TDCA_HOST=0.0.0.0 TDCA_PORT=8000
EXPOSE 8000
CMD ["python", "scripts/serve.py"]
